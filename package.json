{
	"name": "obsidian-external-link-autocomplete",
	"version": "0.0.1",
	"private": true,
	"description": "Suggest external links already used in the vault while typing a Markdown link in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"setup-vault": "npm run build && node scripts/setup-test-vault.mjs",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"release": "node scripts/prepare-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"autocomplete",
		"links"
	],
	"author": "Bruno Ribeiro",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
